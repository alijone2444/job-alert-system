# Local development environment. NEVER commit this file.
# Cloud config lives in Vercel Project Settings / GitHub Secrets.

# --- Firebase credential ---------------------------------------------------
# OPTION A (local): path to the downloaded service-account JSON.
FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.json
# OPTION B (CI/Vercel): the entire JSON on one line.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"job-alert-system-74a27",...}

# --- API auth --------------------------------------------------------------
# Guards GET /api/run. Also the fallback key for the app-facing endpoints.
# RUN_SECRET=change-me
# Guards /api/feed, /api/preferences, /api/interactions, /api/rescore.
# Leave unset locally to run without auth.
# APP_API_KEY=change-me

# --- Ingestion tuning (all optional) ---------------------------------------
# Wall-clock ceiling for one run. Keep below the platform's function timeout.
# RUN_BUDGET_MS=25000

# Kill switch for a misbehaving board — no code change, no redeploy.
# DISABLED_SOURCES=remoteok,ashby

# Override which company boards are polled (comma-separated ATS slugs).
# Find the slug in the careers URL: boards.greenhouse.io/SLUG, jobs.lever.co/SLUG,
# jobs.ashbyhq.com/SLUG. Defaults live in src/sources/companyBoards.js.
# GREENHOUSE_BOARDS=stripe,figma,anthropic
# LEVER_BOARDS=spotify,palantir
# ASHBY_BOARDS=openai,ramp,linear

# Enables Rozee.pk, which is Cloudflare-protected and needs a scraping proxy.
# {url} is replaced with the URL-encoded target.
# SCRAPER_PROXY_URL=https://api.scrapingbee.com/api/v1?api_key=KEY&url={url}

# --- Logging ---------------------------------------------------------------
# debug | info | warn | error | silent
LOG_LEVEL=info

# --- Local poller ----------------------------------------------------------
# Interval for `npm run poll` (the always-on alternative to the cloud cron).
POLL_INTERVAL_SECONDS=120

# NOTE: LINKEDIN_SEARCH_URL / KEYWORD_FILTER / LINKEDIN_GEO_IDS are GONE.
# Those hard-coded one person's preferences into ingestion, which is exactly
# what made the feed global. Relevance is now per-user, decided by the
# recommendation engine from the preferences set in the app's Personalize tab.
